# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Model providers ---
# The default chain uses OpenRouter first and Google AI Studio as the
# cross-provider fallback. Set the keys for whichever providers you list in
# AGENT_MODELS.
OPENROUTER_API_KEY=sk-or-v1-...
GOOGLE_API_KEY=...

# Optional OpenRouter attribution headers.
# OPENROUTER_SITE_URL=https://example.com
# OPENROUTER_APP_NAME=general-agent

# --- Langfuse tracing ---
# Both keys are required; with only one, tracing stays off rather than
# authenticating with nothing and silently dropping every span.
# Settings > API Keys in your Langfuse project.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Must match the project's region: EU (default), US, JP, or your self-hosted URL.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# Turn tracing off without removing credentials.
# AGENT_TRACING_ENABLED=true
# Fraction of traces to send. Lower it under load.
# LANGFUSE_SAMPLE_RATE=1.0

# Keeps test traces out of production dashboards, and ties a regression to a
# deploy.
APP_ENV=development
# APP_RELEASE=general-agent@0.1.0

# Trace dimensions to filter and break metrics down by.
# AGENT_TAGS=support,eu
# USER_ID=anonymous

# --- Agent ---
# Failover chain, best model first. The first entry is the agent's own model;
# the rest are what a 429 falls back to. Crossing providers matters — limits
# are usually metered per account, not per model.
# AGENT_MODELS=openrouter:openai/gpt-4o-mini,openrouter:meta-llama/llama-3.3-70b-instruct,google:gemini-flash-latest
# AGENT_SYSTEM_PROMPT=You are a helpful assistant.
# AGENT_NAME=general-agent

# --- Failover behaviour ---
# How long a 429'd model is deprioritised within a run. 0 disables.
# AGENT_COOLDOWN_SECONDS=60
# Cool down every route sharing a credential, not just the model that failed.
# Set this when the provider's limit is account-wide (OpenRouter's free tier is).
# AGENT_ACCOUNT_COOLDOWN=false
# Sleep for the provider's Retry-After hint before the next attempt.
# AGENT_RESPECT_RETRY_AFTER=false

# Route each OpenRouter model over several credentials. Only engages when at
# least two keys are actually found. accounts_from_env picks up numbered
# variants and comma-separated values.
# AGENT_POOL_OPENROUTER_ACCOUNTS=false
# AGENT_OPENROUTER_KEY_VARS=OPENROUTER_API_KEY
# OPENROUTER_API_KEY_1=sk-or-v1-...
# OPENROUTER_API_KEY_2=sk-or-v1-...
# How a pool picks between accounts: round_robin (default), priority,
# or least_recently_limited.
# RATELIMIT_FALLBACK_STRATEGY=round_robin

# --- Tools ---
# Web search is added only when langchain-tavily and this key are both present.
# TAVILY_API_KEY=tvly-...
# AGENT_ENABLE_WEB_SEARCH=true
# AGENT_MAX_SEARCH_RESULTS=5

# --- MCP servers ---
# Any MCP server's tools become the agent's tools. Point this at an mcpServers
# JSON file — the same format Claude Desktop, VS Code and Cursor use — or leave
# it unset and drop an mcp.json in the working directory.
# AGENT_MCP_CONFIG=./mcp.json
# Or define servers inline, for containers with nothing to mount. Overrides the
# file on a name clash.
# AGENT_MCP_SERVERS={"mcpServers":{"api":{"url":"https://mcp.example.com/mcp","headers":{"Authorization":"Bearer ${INTERNAL_TOKEN}"}}}}
# INTERNAL_TOKEN=...

# Fail startup when a configured server is unreachable. Off by default: one
# server having a bad day costs you its tools, not the agent.
# AGENT_MCP_STRICT=false
# Namespace MCP tools by server (github_create_issue). On by default — two
# servers exposing "search" is normal, and a silent collision shadows one.
# AGENT_MCP_TOOL_PREFIX=true
# Seconds to wait for one server to hand over its tool list.
# AGENT_MCP_STARTUP_TIMEOUT=30

# --- A2A server (general-agent --serve) ---
# Other agents discover this one at /.well-known/agent-card.json.
# AGENT_A2A_HOST=127.0.0.1
# AGENT_A2A_PORT=8080
# The address other agents can actually reach. Set this behind a proxy or in a
# container — the bind address is not a callback address.
# AGENT_A2A_URL=https://agents.example.com
