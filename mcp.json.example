{
  "_comment": [
    "Copy to mcp.json (or point AGENT_MCP_CONFIG anywhere) to onboard MCP servers.",
    "Same format Claude Desktop, VS Code and Cursor use, so a server stanza can be",
    "copied straight across. ${VAR} is read from the environment, so tokens stay in",
    ".env and this file stays committable. Set \"disabled\": true to keep a server",
    "here without loading it. Run `general-agent --list-tools` to see what arrived."
  ],
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/srv/data"]
    },
    "internal-api": {
      "type": "http",
      "url": "https://mcp.example.com/mcp",
      "headers": { "Authorization": "Bearer ${INTERNAL_API_TOKEN}" }
    },
    "legacy-sse-server": {
      "type": "sse",
      "url": "https://mcp.example.com/sse",
      "disabled": true
    }
  }
}
